/*
Temporal mule detection and Zelle transfer schema. Target: TigerGraph 4.2.5.
Fresh-graph DDL only. Existing-graph changes live in migrations/; the original
temporal_valid_time migration requires an empty graph and must not be rerun.

One Zelle_Transfer vertex represents one individual Zelle payment. Other rails
use Payment_Transaction; never duplicate a Zelle transfer in both event types.
Persistent entity IDs are opaque/tokenized. Entity feature metadata is immutable after
first observation. No whole-history Account features or split flags are stored.
Payment vertices can cache causal pair-gap encodings calculated by GSQL.
Cutoff-dependent age encodings are query outputs, never persistent attributes.
Account mule truth, mask and PU labels, and Zelle transfer labels are supervision
only. Never pass them, their clocks, their provenance or ring IDs to the model
as features. Masking changes is_mule_masked and pu_label, never is_mule.

Use ONE common chronological sequence domain for payment events and association
changes. Positive sequence values are required. Zero valid_to_seq means open.
Every association tenure uses exactly this visibility rule, in either direction:
  rel.valid_from_seq <= seed_seq
  AND (rel.valid_to_seq == 0 OR seed_seq < rel.valid_to_seq).
DISCRIMINATOR(valid_from_seq) keeps repeated tenures between the same endpoints.
Point-event participation edges carry event_seq and event_ts_ms instead of
validity intervals. Historical event context uses event_seq < seed_seq.

Known-time fields are deferred until source feeds are confirmed. Valid time
alone cannot exclude a backdated correction learned after a historical seed.
This file contains graph DDL only. loading_jobs.gsql maps the six-column
PostgreSQL Account feed to this storage order; absent supervision fields
and payment caches retain their defaults. Source is_mule is supervision only.
*/

CREATE GRAPH Mule_Pattern_Learner ()
USE GRAPH Mule_Pattern_Learner

CREATE SCHEMA_CHANGE JOB create_temporal_payment_schema
FOR GRAPH Mule_Pattern_Learner {

  ADD VERTEX Party (
    PRIMARY_ID id STRING,
    party_type STRING DEFAULT "unknown",
    first_seen_seq UINT,
    first_seen_ts_ms UINT
  ) WITH PRIMARY_ID_AS_ATTRIBUTE="true", STATS="OUTDEGREE_BY_EDGETYPE";

  ADD VERTEX Account (
    PRIMARY_ID id STRING,
    account_type STRING DEFAULT "unknown",
    is_external BOOL DEFAULT "false",
    first_seen_seq UINT,
    first_seen_ts_ms UINT,
    mule_label_known BOOL DEFAULT "false",
    is_mule_masked BOOL DEFAULT "true",
    pu_label INT DEFAULT 0,
    mule_label_effective_seq UINT DEFAULT 0,
    mule_label_effective_ts_ms UINT DEFAULT 0,
    mule_label_available_seq UINT DEFAULT 0,
    mule_label_available_ts_ms UINT DEFAULT 0,
    mule_ring_id INT DEFAULT -1,
    mule_label_source STRING DEFAULT "",
    is_mule INT DEFAULT 0
  ) WITH PRIMARY_ID_AS_ATTRIBUTE="true", STATS="OUTDEGREE_BY_EDGETYPE";

  ADD VERTEX Token (
    PRIMARY_ID token_id STRING,
    first_seen_seq UINT,
    first_seen_ts_ms UINT,
    token_kind STRING DEFAULT "unknown",
    token_network STRING DEFAULT "unknown"
  ) WITH PRIMARY_ID_AS_ATTRIBUTE="true", STATS="OUTDEGREE_BY_EDGETYPE";

  ADD VERTEX Device (
    PRIMARY_ID id STRING,
    device_type STRING DEFAULT "unknown",
    first_seen_seq UINT,
    first_seen_ts_ms UINT
  ) WITH PRIMARY_ID_AS_ATTRIBUTE="true", STATS="OUTDEGREE_BY_EDGETYPE";

  ADD VERTEX IP (
    PRIMARY_ID id STRING,
    first_seen_seq UINT,
    first_seen_ts_ms UINT
  ) WITH PRIMARY_ID_AS_ATTRIBUTE="true", STATS="OUTDEGREE_BY_EDGETYPE";

  ADD VERTEX Address (
    PRIMARY_ID address_id STRING,
    first_seen_seq UINT,
    first_seen_ts_ms UINT,
    country_code STRING DEFAULT ""
  ) WITH PRIMARY_ID_AS_ATTRIBUTE="true", STATS="OUTDEGREE_BY_EDGETYPE";

  ADD VERTEX Payment_Transaction (
    PRIMARY_ID transaction_id STRING,
    amount DOUBLE DEFAULT 0.0,
    currency STRING DEFAULT "",
    payment_rail STRING DEFAULT "unknown",
    channel STRING DEFAULT "unknown",
    event_time DATETIME,
    event_ts_ms UINT,
    event_seq UINT,
    amount_present BOOL DEFAULT "false",
    pair_delta_t_ms UINT DEFAULT 0,
    pair_delta_t_present BOOL DEFAULT "false",
    pair_time_encoding LIST<DOUBLE>,
    time_encoding_basis_id STRING DEFAULT "",
    pair_previous_event_id STRING DEFAULT "",
    pair_sender_id STRING DEFAULT "",
    pair_recipient_type STRING DEFAULT "",
    pair_recipient_id STRING DEFAULT ""
  ) WITH PRIMARY_ID_AS_ATTRIBUTE="true", STATS="OUTDEGREE_BY_EDGETYPE";

  ADD VERTEX Zelle_Transfer (
    PRIMARY_ID transfer_id STRING,
    event_time DATETIME,
    event_ts_ms UINT,
    event_seq UINT,
    amount DOUBLE DEFAULT 0.0,
    amount_present BOOL DEFAULT "false",
    currency STRING DEFAULT "",
    channel STRING DEFAULT "unknown",
    fraud_label INT DEFAULT -1,
    label_known BOOL DEFAULT "false",
    label_available_seq UINT DEFAULT 0,
    label_available_ts_ms UINT DEFAULT 0,
    pair_delta_t_ms UINT DEFAULT 0,
    pair_delta_t_present BOOL DEFAULT "false",
    pair_time_encoding LIST<DOUBLE>,
    time_encoding_basis_id STRING DEFAULT "",
    pair_previous_event_id STRING DEFAULT "",
    pair_sender_id STRING DEFAULT "",
    pair_recipient_type STRING DEFAULT "",
    pair_recipient_id STRING DEFAULT ""
  ) WITH PRIMARY_ID_AS_ATTRIBUTE="true", STATS="OUTDEGREE_BY_EDGETYPE";

  /* Valid-time association tenures. */

  ADD DIRECTED EDGE Party_Owns_Account (
    FROM Party, TO Account,
    DISCRIMINATOR(valid_from_seq UINT),
    valid_to_seq UINT DEFAULT 0,
    confidence FLOAT DEFAULT 1.0,
    source_system STRING DEFAULT ""
  ) WITH REVERSE_EDGE="Account_Owned_By_Party";

  ADD DIRECTED EDGE Party_Uses_Token (
    FROM Party, TO Token,
    DISCRIMINATOR(valid_from_seq UINT),
    valid_to_seq UINT DEFAULT 0,
    confidence FLOAT DEFAULT 1.0,
    source_system STRING DEFAULT ""
  ) WITH REVERSE_EDGE="Token_Used_By_Party";

  ADD DIRECTED EDGE Token_Bound_To_Account (
    FROM Token, TO Account,
    DISCRIMINATOR(valid_from_seq UINT),
    valid_to_seq UINT DEFAULT 0,
    confidence FLOAT DEFAULT 1.0,
    source_system STRING DEFAULT ""
  ) WITH REVERSE_EDGE="Account_Bound_From_Token";

  ADD DIRECTED EDGE Party_Uses_Device (
    FROM Party, TO Device,
    DISCRIMINATOR(valid_from_seq UINT),
    valid_to_seq UINT DEFAULT 0,
    confidence FLOAT DEFAULT 1.0,
    source_system STRING DEFAULT ""
  ) WITH REVERSE_EDGE="Device_Used_By_Party";

  ADD DIRECTED EDGE Account_Uses_Device (
    FROM Account, TO Device,
    DISCRIMINATOR(valid_from_seq UINT),
    valid_to_seq UINT DEFAULT 0,
    confidence FLOAT DEFAULT 1.0,
    source_system STRING DEFAULT ""
  ) WITH REVERSE_EDGE="Device_Used_By_Account";

  ADD DIRECTED EDGE Party_Uses_IP (
    FROM Party, TO IP,
    DISCRIMINATOR(valid_from_seq UINT),
    valid_to_seq UINT DEFAULT 0,
    confidence FLOAT DEFAULT 1.0,
    source_system STRING DEFAULT ""
  ) WITH REVERSE_EDGE="IP_Used_By_Party";

  ADD DIRECTED EDGE Party_Has_Address (
    FROM Party, TO Address,
    DISCRIMINATOR(valid_from_seq UINT),
    valid_to_seq UINT DEFAULT 0,
    confidence FLOAT DEFAULT 1.0,
    source_system STRING DEFAULT ""
  ) WITH REVERSE_EDGE="Address_Used_By_Party";

  /* Point-event participation, with explicit roles and repeated clocks. */

  ADD DIRECTED EDGE Transfer_From_Account (
    FROM Zelle_Transfer, TO Account,
    event_ts_ms UINT,
    event_seq UINT
  ) WITH REVERSE_EDGE="Account_Sent_Zelle_Transfer";

  ADD DIRECTED EDGE Transfer_To_Account (
    FROM Zelle_Transfer, TO Account,
    event_ts_ms UINT,
    event_seq UINT
  ) WITH REVERSE_EDGE="Account_Received_Zelle_Transfer";

  ADD DIRECTED EDGE Transfer_From_Token (
    FROM Zelle_Transfer, TO Token,
    event_ts_ms UINT,
    event_seq UINT
  ) WITH REVERSE_EDGE="Token_Sent_Transfer";

  ADD DIRECTED EDGE Transfer_To_Token (
    FROM Zelle_Transfer, TO Token,
    event_ts_ms UINT,
    event_seq UINT
  ) WITH REVERSE_EDGE="Token_Received_Transfer";

  ADD DIRECTED EDGE Transfer_Used_Device (
    FROM Zelle_Transfer, TO Device,
    event_ts_ms UINT,
    event_seq UINT
  ) WITH REVERSE_EDGE="Device_Used_By_Transfer";

  ADD DIRECTED EDGE Transfer_Used_IP (
    FROM Zelle_Transfer, TO IP,
    event_ts_ms UINT,
    event_seq UINT
  ) WITH REVERSE_EDGE="IP_Used_By_Transfer";

  ADD DIRECTED EDGE Transaction_From_Account (
    FROM Payment_Transaction, TO Account,
    event_ts_ms UINT,
    event_seq UINT
  ) WITH REVERSE_EDGE="Account_Initiated_Transaction";

  ADD DIRECTED EDGE Transaction_To_Account (
    FROM Payment_Transaction, TO Account,
    event_ts_ms UINT,
    event_seq UINT
  ) WITH REVERSE_EDGE="Account_Received_Transaction";

  ADD DIRECTED EDGE Transaction_From_Token (
    FROM Payment_Transaction, TO Token,
    event_ts_ms UINT,
    event_seq UINT
  ) WITH REVERSE_EDGE="Token_Sent_Transaction";

  ADD DIRECTED EDGE Transaction_To_Token (
    FROM Payment_Transaction, TO Token,
    event_ts_ms UINT,
    event_seq UINT
  ) WITH REVERSE_EDGE="Token_Received_Transaction";

  ADD DIRECTED EDGE Transaction_Used_Device (
    FROM Payment_Transaction, TO Device,
    event_ts_ms UINT,
    event_seq UINT
  ) WITH REVERSE_EDGE="Device_Used_By_Transaction";

  ADD DIRECTED EDGE Transaction_Used_IP (
    FROM Payment_Transaction, TO IP,
    event_ts_ms UINT,
    event_seq UINT
  ) WITH REVERSE_EDGE="IP_Observed_In_Transaction";
}

RUN SCHEMA_CHANGE JOB create_temporal_payment_schema
DROP JOB create_temporal_payment_schema
