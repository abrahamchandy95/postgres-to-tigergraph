  scan_Account_Received_Zelle_Transfer = SELECT t FROM Account:t -(Account_Received_Zelle_Transfer>:e)- Zelle_Transfer:s ACCUM @@counts += ("Account_Received_Zelle_Transfer" -> 1), IF e.event_seq != s.event_seq OR e.event_ts_ms != s.event_ts_ms OR t.first_seen_seq > e.event_seq OR t.first_seen_ts_ms > e.event_ts_ms THEN @@violations += 1 END;
  scan_Transfer_From_Token = SELECT s FROM Zelle_Transfer:s -(Transfer_From_Token>:e)- Token:t ACCUM @@counts += ("Transfer_From_Token" -> 1), IF e.event_seq != s.event_seq OR e.event_ts_ms != s.event_ts_ms OR t.first_seen_seq > e.event_seq OR t.first_seen_ts_ms > e.event_ts_ms THEN @@violations += 1 END;
