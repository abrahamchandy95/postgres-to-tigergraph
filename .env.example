# Shared TigerGraph connection. The graph must already exist.
HOST=https://your-workspace.i.tgcloud.io
GRAPHNAME=Mule_Pattern_Learner
SECRET=

# Existing card-fraud use case (requires GRAPHNAME=TransactionFraud_GNN).
PG_DSN=dbname=phantomledger
EXPORT_DIR=./artifacts/tfgnn_load
SHARD_BYTES=90000000
TFGNN_PII_SALT=

# Temporal mule use case. PG_DSN is the fallback when MULE_PG_DSN is absent.
MULE_PG_DSN=dbname=phantomledger
MULE_EXPORT_DIR=./artifacts/mule_temporal
MULE_UPLOAD_BYTES=10000000
MULE_UPLOAD_WORKERS=1
