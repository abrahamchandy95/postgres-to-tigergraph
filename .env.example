# Copy to .env and fill in. .env is gitignored, so a fresh clone has
# none of this and every value below has to be supplied again.
#
#   cp .env.example .env

# ---------------------------------------------------------------------
# TigerGraph
# ---------------------------------------------------------------------
HOST=https://<workspace>.i.tgcloud.io

GRAPHNAME=TransactionFraud_GNN

# Minted PER GRAPH in the Savanna console. A secret for a different graph
# will authenticate and then fail to find this one.
SECRET=

# ---------------------------------------------------------------------
# PostgreSQL source
# ---------------------------------------------------------------------
# Local socket:   dbname=phantomledger
# Remote:         host=db.example.internal port=5432 dbname=phantomledger user=loader
#                 (put the password in ~/.pgpass rather than here if you prefer)
#
# `prepare` WRITES to this database: it creates the tf_gnn_prep schema and
# adds indices to the card_fraud.cf_* tables, so a read-only user fails at
# 010_create_source_indices.sql.
PG_DSN=dbname=phantomledger

# ---------------------------------------------------------------------
# Local load artifacts
# ---------------------------------------------------------------------
# PSV shards land here --- several GB at corpus scale. Written on whichever
# machine runs `export`, not on the database host.
EXPORT_DIR=./artifacts/tf_gnn_load

# Must stay below TigerGraph's 128 MB upload limit; the loader refuses
# anything at or above 128,000,000.
SHARD_BYTES=90000000

# ---------------------------------------------------------------------
# PII tokenisation
# ---------------------------------------------------------------------
# The HMAC-SHA256 key behind the Device, IP_Address, Email, Phone, Address
# and Identity_Document primary ids. Required by `prepare` only --- inspect,
# audit, export and verify all read the materialised token tables and do
# not need it.
#
# At least 16 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# ONE SALT PER GRAPH, AND IT NEVER CHANGES. It is not a per-machine
# setting: if two machines ever run `prepare` against the same graph, the
# value must be byte-identical on both, or the second run produces a
# disjoint set of PII vertices beside the first. The preparation schema
# stores the salt's digest and hard-fails on a mismatch, so you get a loud
# error rather than a silently forked graph --- but the only fixes are the
# original salt or a full reload.
#
# If the graph has never been loaded, any fresh value is fine.
TFGNN_PII_SALT=
